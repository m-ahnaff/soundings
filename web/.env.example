# Leave the Supabase values empty to run the local demo (seeded data + a "View as" switch).
NEXT_PUBLIC_SUPABASE_URL=
# The project's publishable key (sb_publishable_...). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the FastAPI service is deployed.
NEXT_PUBLIC_API_URL=http://localhost:8800
# Optional: the product whose feedback this board collects.
NEXT_PUBLIC_BOARD_NAME=Larder
