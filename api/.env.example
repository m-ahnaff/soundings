# Leave SUPABASE_URL empty to run the in-memory demo (seeded data, X-Demo-User header).
# Demo mode is impossible while SUPABASE_URL is set.
SUPABASE_URL=
# The project's *publishable* key (sb_publishable_...). Never a secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated list of allowed browser origins (your web app's URL).
CORS_ORIGINS=http://localhost:3100
# Optional: create-post/comment budget per user per minute (0 disables).
WRITE_LIMIT_PER_MINUTE=12
